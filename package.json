{
  "name": "regex-highlighter",
  "version": "1.0.0",
  "description": "Generate color highlighting, optimization, and other features for regexes.",
  "main": "regex-highlighter.js",
  "module": "regex-highlighter.js",
  "scripts": {
    "test": "ava --verbose tests/*.js",
    "build": "browserify --debug src/index.js -p esmify | squash > web/bundle.js",
    "watch": "watchify --debug src/index.js -p esmify -o web/bundle.js -v",
    "build-prod": "browserify src/index.js -p esmify | squash > web/bundle.js",
    "watch-prod": "watchify src/index.js -p esmify -o web/bundle.js -v"
  },
  "author": "Danny Brian",
  "license": "ISC",
  "devDependencies": {
    "ava": "^1.3.1",
    "browser-resolve": "^1.11.3",
    "butternut": "^0.4.6",
    "esmify": "^2.1.1",
    "watchify": "^3.11.1"
  },
  "ava": {
    "require": [
      "esm"
    ]
  },
  "dependencies": {
    "esm": "^3.2.20",
    "regexp-tree": "^0.1.5"
  }
}
